<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  make install-agent 的模板：只放固定配置。
  Label、ProgramArguments、日志路径由 Makefile 用 plutil 写入，plutil 负责 XML 转义，路径里有空格或 & 也安全。
-->
<plist version="1.0">
<dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- 只在异常退出时重启；正常收到 SIGTERM 退出（exit 0）不拉起 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
